// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String?
  firstName     String
  lastName      String

  oAuthAccounts OAuthAccounts[]
  otps          Otp[]
  isVerified    Boolean  @default(false)
  refreshHashToken  String?  @unique

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("users")
}

model Otp {
  id        String    @id @default(uuid())
  userId    String
  purpose   OtpPurpose
  hash      String
  attempts  Int       @default(0)
  expiresAt DateTime
  used      Boolean   @default(false)
  createdAt DateTime  @default(now())
  
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, purpose, used])
  
  @@map("otps")
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  TWO_FACTOR
}

// model for storing data for OAuth logins for different providers
model OAuthAccounts {
  provider_user_id  String  @id
  provider          String
  userId            String
  user              User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("oAuthAccounts")
}